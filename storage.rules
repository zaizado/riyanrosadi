rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Default deny catch-all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isDocument() {
      return request.resource.contentType.matches('application/pdf') ||
             request.resource.contentType.matches('application/msword') ||
             request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document') ||
             request.resource.contentType.matches('application/vnd.ms-excel') ||
             request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
    }

    function isWithin5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    function isWithin20MB() {
      return request.resource.size < 20 * 1024 * 1024;
    }

    // User avatars - strictly owned by the authenticated user (UID)
    match /avatars/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId && isWithin5MB() && isImage();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Member photos
    match /members/{memberId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isWithin5MB() && isImage();
      allow delete: if isSignedIn();
    }

    // Agenda & minute attachments
    match /notulensi/{agendaId}/{attachmentId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isWithin20MB() && (isImage() || isDocument());
      allow delete: if isSignedIn();
    }

    // Advocacy attachments
    match /advocacy/{caseId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isWithin20MB() && (isImage() || isDocument());
      allow delete: if isSignedIn();
    }

    // Sick visit attachments
    match /sickVisits/{visitId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isWithin20MB() && (isImage() || isDocument());
      allow delete: if isSignedIn();
    }

    // General uploads
    match /uploads/{folder}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isWithin20MB() && (isImage() || isDocument());
      allow delete: if isSignedIn();
    }
  }
}
